# FlyRank Frontend AI Engineering Track — Environment Variables
# Copy this file to .env.local for local development. NEVER commit .env or secrets to Git!

# Application URL (used by Server Components for internal health diagnostics)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Inference Gateway (Safe placeholders — configure real keys in Vercel/Netlify Environment Variables)
AI_GATEWAY_PROVIDER="google-antigravity"
AI_PROVIDER_KEY="sk-antigravity-placeholder-key-xxxxxxxx"

# Telemetry & Monitoring Webhook
NEXT_PUBLIC_TELEMETRY_ENDPOINT="https://telemetry.flyrank.ai/events"
NEXT_PUBLIC_APP_VERSION="1.0.0-fe04-preview"
