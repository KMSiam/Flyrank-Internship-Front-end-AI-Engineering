# Copy this file to .env.local for local development. NEVER commit .env or secrets to Git!

# Application URL (used by Server Components for internal health diagnostics)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Inference Gateway & Providers (Safe placeholders â€” configure real keys in Vercel/Netlify Environment Variables)
AI_GATEWAY_PROVIDER="google-antigravity"
AI_PROVIDER_KEY="sk-antigravity-placeholder-key-xxxxxxxx"
ANTHROPIC_API_KEY="sk-ant-api03-placeholder-key-xxxxxxxx"
OPENAI_API_KEY="sk-proj-placeholder-key-xxxxxxxx"

# Rate Limiting & Production Max Duration
CHAT_MAX_DURATION_SECONDS=30
RATE_LIMIT_MAX_PER_MINUTE=30
PROMPT_MAX_CHAR_LIMIT=4000

# Telemetry & Monitoring Webhook
NEXT_PUBLIC_TELEMETRY_ENDPOINT="https://telemetry.flyrank.ai/events"
NEXT_PUBLIC_APP_VERSION="1.0.0-production"
